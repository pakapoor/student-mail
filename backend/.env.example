PORT=3001

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=student_mail
DB_USER=student_mail_app
DB_PASSWORD=

# Optional: used by CLI scripts (sync-mail.ts, test-reply.ts) for convenience.
# The running server itself authenticates central mailboxes via login (see
# central_mailboxes table), not these env vars.
CENTRAL_EMAIL=
CENTRAL_EMAIL_PASSWORD=

# Restrict login and background sync to the active operational mailbox.
# Leave blank only when all registered mailboxes use the same IMAP provider.
ACTIVE_CENTRAL_EMAIL=central.ksma@myemailinfo.com

# IMAP (shared host across all active central mailboxes)
IMAP_HOST=imap.migadu.com
IMAP_PORT=993
IMAP_SECURE=true

# SMTP (Migadu - used for sending as students)
SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_SECURE=true

# Optional
FRONTEND_ORIGIN=http://localhost:5173
SYNC_INTERVAL_MS=20000
FALLBACK_SYNC_INTERVAL_MS=5000

# Creating a student's mailbox when staff add students (migadu.ts). The key is
# a dedicated one from Migadu > My Account > API Keys, not the login password.
# MIGADU_DOMAIN is optional (default myemailinfo.com).
MIGADU_ADMIN_EMAIL=
MIGADU_API_KEY=
# MIGADU_DOMAIN=myemailinfo.com

# Log a [migadu-delay] warning when Migadu held an email longer than this
# (minutes) between accepting it and storing it in the mailbox.
MIGADU_DELAY_WARN_MIN=5

# Rolling daily sweep of every student mailbox (sweep.ts): one full round
# every SWEEP_ROUND_HOURS, SWEEP_BATCH_SIZE mailboxes per batch. Set
# SWEEP_ENABLED=false to turn it off.
SWEEP_ENABLED=true
SWEEP_ROUND_HOURS=24
SWEEP_BATCH_SIZE=5

# Hot list (hotList.ts): after an Edugate code arrives, check that
# student's mailbox every HOT_FAST_INTERVAL_S for HOT_FAST_MINUTES, then every
# HOT_INTERVAL_S, until registration arrives or 35 minutes pass (code validity
# 30 min + 5 min for a last-minute registration email to arrive; fixed).
HOT_ENABLED=true
HOT_FAST_INTERVAL_S=30
HOT_FAST_MINUTES=5
HOT_INTERVAL_S=120
